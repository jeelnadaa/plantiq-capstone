# Copy to compare/.env (git-ignored) and paste your Gemini key. Only the RAG notebooks (03_*) need it.
GEMINI_API_KEY=

# --- models (defaults shown; you normally change nothing)
# The benchmark tests the RAG pipelines, not the language models: PlantIQ and the Selva Kumar et al. baseline
# both use GENERATOR_MODEL, so any difference comes from retrieval, prompting and grounding.
GENERATOR_MODEL=gemini:gemini-3.5-flash-lite
# JUDGE writes/checks the question set and scores every answer; a different, stronger model than the generator.
JUDGE_MODEL=gemini:gemini-3.5-flash
# Optional: give the baseline its own LLM (e.g. groq:llama-3.1-8b-instant with GROQ_API_KEY). Not needed.
# BASELINE_LLM_MODEL=
# GROQ_API_KEY=

# --- free-tier speed limit (requests per minute). Lower it if you see many "429" retries.
GEMINI_RPM=10

# --- CNN: number of cross-validation folds (set before running 01_dataset_audit; default 5)
# PLANTIQ_FOLDS=5
