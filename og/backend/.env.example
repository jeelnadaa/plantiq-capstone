# PlantIQ Cleaned & Production-Ready Configuration
PROJECT_NAME="PlantIQ Cleaned API"
VERSION="2.0.0"

# Confidence Blending Thresholds
CONFIDENCE_THRESHOLD_CNN=75.0
CONFIDENCE_THRESHOLD_RAG=0.60

# LLM Providers (At least one required)
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
HF_TOKEN=your_huggingface_token_here

# ==============================================================================
# Speech-to-Text (STT) Model Configuration
# ==============================================================================
# Master toggle: set to false to completely turn off all local STT models
ENABLE_LOCAL_STT=true

# Granular toggles: turn off local English or Kannada STT separately
ENABLE_LOCAL_ENGLISH_STT=true   # Svarah Indian English Whisper (local)
ENABLE_LOCAL_KANNADA_STT=true   # IndicConformer 600M Kannada (local)

# Security
SECRET_KEY=change_this_to_a_secure_random_jwt_secret_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=10080
DEBUG=false
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000,http://localhost:5173

# ==============================================================================
# PostgreSQL Database Configuration
# ==============================================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=plantiq

# Optional: Direct PostgreSQL Connection URL (if provided, overrides individual POSTGRES_* fields above)
# e.g., postgresql://username:password@localhost:5432/plantiq
# DATABASE_URL=postgresql://postgres:your_postgres_password_here@localhost:5432/plantiq
