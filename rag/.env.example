# ─── Coffee RAG – Environment Configuration ───────────────────────
# Copy this file to .env and fill in your values.

# Gemini API key (required)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model to use
GEMINI_MODEL=gemini-1.5-flash

# Folder containing your PDF knowledge base
PDF_FOLDER=./knowledge_base

# Folder where FAISS index is saved / loaded from
INDEX_FOLDER=./index

# Number of chunks to retrieve (optional, default 5)
TOP_K=5
