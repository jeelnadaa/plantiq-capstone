# Copy to compare/.env (git-ignored) and paste your keys. Only the RAG notebooks (03_*) need keys.
# Everything else below already has working defaults; you normally change nothing but the two keys.

GEMINI_API_KEY=
GROQ_API_KEY=

# --- models per role ("provider:model"). Defaults (used when a line is missing):
#   GENERATOR     gemini:gemini-3.5-flash-lite   PlantIQ's own LLM
#   BASELINE_LLM  groq:llama-3.1-8b-instant      stands in for GPT-3.5 in the Selva Kumar et al. baseline
#   JUDGE         gemini:gemini-3.5-flash        writes/checks the questions and scores every answer
# Without GROQ_API_KEY the baseline falls back to gemini:gemini-3.5-flash-lite (the notebooks print this).
GENERATOR_MODEL=gemini:gemini-3.5-flash-lite
BASELINE_LLM_MODEL=groq:llama-3.1-8b-instant
JUDGE_MODEL=gemini:gemini-3.5-flash

# --- free-tier speed limits (requests per minute). Lower them if you see many "429" retries.
GEMINI_RPM=10
GROQ_RPM=25

# --- CNN: number of cross-validation folds (set before running 01_dataset_audit; default 5)
# PLANTIQ_FOLDS=5

# --- optional, only if you have one: OpenAI key (then the baseline can use real GPT-3.5 / OpenAI embeddings)
# OPENAI_API_KEY=
