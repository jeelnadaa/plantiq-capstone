# PlantIQ backend configuration. Copy to backend/.env and fill in.

# development | production   (production: docs off, strict CORS, SECRET_KEY required)
ENV=development
# 32+ random characters, e.g. python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=

# --- Database: SQLite (var/plantiq.db) by default. Set either DATABASE_URL or POSTGRES_* to use PostgreSQL. ---
# DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/plantiq_claude
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=
# POSTGRES_DB=plantiq_claude
DB_FALLBACK_TO_SQLITE=true

# --- LLM providers (Gemini first, Groq second, built-in offline guide last) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
HF_TOKEN=

# --- CNN (same weights as the original app) ---
# CNN_WEIGHTS_PATH=data/models/best_resnet50_coffee.pth
CONFIDENCE_THRESHOLD_CNN=75.0
CONFIDENCE_THRESHOLD_RAG=0.60
# auto | cuda | cpu
ML_DEVICE=auto

# --- RAG: auto picks "quality" (bge-m3 + bge-reranker-v2-m3) on a >=6 GB GPU, else "balanced" (bge-base + MiniLM) ---
RAG_PROFILE=auto
RAG_AUTO_BUILD=true

# --- Speech to text ---
ENABLE_LOCAL_STT=true
ENABLE_LOCAL_KANNADA_STT=true
ENABLE_LOCAL_ENGLISH_STT=true
INDIC_CONFORMER_DECODER=ctc

# --- Security / limits ---
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MIN=20
RATE_LIMIT_HEAVY_PER_MIN=30
RATE_LIMIT_DEFAULT_PER_MIN=240
# Extra allowed browser origins (LAN IPs and localhost are allowed automatically in development)
CORS_ORIGINS=http://localhost,https://localhost,capacitor://localhost,http://localhost:5173
# Set true only behind a reverse proxy you control (uses X-Forwarded-For)
TRUST_PROXY_HEADERS=false

# Deterministic fake ML (tests / UI demos without GPU)
PLANTIQ_FAKE_ML=false
